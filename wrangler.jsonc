{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lypa-lounge-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "build": {
    "command": "npm run build",
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"],
  },
  "dev": {
    "ip": "127.0.0.1",
    "port": 8787,
  },
  "vars": {
    "ADMIN_ORIGIN": "https://lypa-lounge-api.oakforge.workers.dev",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lypa-lounge-db",
      "database_id": "d7326c84-e12d-4ad1-a724-5783eca1a44f",
      "migrations_dir": "migrations",
    },
  ],
}
